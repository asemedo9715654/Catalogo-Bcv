@model IEnumerable<CatalogoBCV.Models.User>

@{
    ViewData["Title"] = "Gestão de Utilizadores";
}



<div class="app-content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card card-outline card-primary">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="bi bi-people me-2"></i> Lista de Utilizadores
                        </h3>
                        <div class="card-tools d-flex align-items-center">
                             <a asp-action="Create" class="btn btn-primary btn-sm me-3">
                                <i class="bi bi-person-plus"></i> Novo Utilizador
                            </a>
                            <div class="input-group input-group-sm" style="width: 250px;">
                                <input type="text" id="userSearch" class="form-control float-right" placeholder="Pesquisar utilizador...">
                                <div class="input-group-append">
                                    <button type="submit" class="btn btn-default">
                                        <i class="bi bi-search"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card-body table-responsive p-0">
                        <table class="table table-hover text-nowrap" id="usersTable">
                            <thead>
                                <tr>
                                    <th><i class="bi bi-person me-1"></i> Username</th>
                                    <th><i class="bi bi-shield-lock me-1"></i> Função</th>
                                    <th class="text-center"><i class="bi bi-toggle-on me-1"></i> Estado</th>
                                    <th class="text-end">Ações</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null && Model.Any())
                                {
                                    foreach (var item in Model)
                                    {
                                        <tr>
                                            <td class="align-middle">
                                                <div class="d-flex align-items-center">
                                                    <div class="bg-light rounded-circle p-2 me-2 d-flex align-items-center justify-content-center" style="width: 35px; height: 35px;">
                                                        <i class="bi bi-person text-secondary"></i>
                                                    </div>
                                                    <div>
                                                        <div class="fw-bold">@item.Username</div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="align-middle">
                                                <span class="badge rounded-pill bg-@(item.Role == CatalogoBCV.Models.UserRole.Admin ? "danger" : "primary") bg-opacity-75">
                                                    <i class="bi @(item.Role == CatalogoBCV.Models.UserRole.Admin ? "bi-shield-fill" : "bi-person-badge") me-1"></i>
                                                    @item.Role
                                                </span>
                                            </td>
                                            <td class="align-middle text-center">
                                                @if (item.IsActive)
                                                {
                                                    <span class="badge bg-success rounded-pill">
                                                        <i class="bi bi-check-circle me-1"></i> Ativo
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary rounded-pill">
                                                        <i class="bi bi-x-circle me-1"></i> Inativo
                                                    </span>
                                                }
                                            </td>
                                            <td class="align-middle text-end">
                                                 <button type="button" class="btn btn-sm btn-outline-secondary" disabled title="Editar (Em breve)">
                                                    <i class="bi bi-pencil"></i>
                                                </button>
                                                <button type="button" class="btn btn-sm btn-outline-danger" disabled title="Remover (Em breve)">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center py-5">
                                            <div class="text-muted">
                                                <i class="bi bi-people display-4 mb-3 d-block"></i>
                                                <h5>Nenhum utilizador encontrado</h5>
                                                <p class="mb-0">Utilize o botão "Novo Utilizador" para adicionar registos.</p>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="card-footer clearfix">
                         <div class="float-end text-muted small">
                            Total: @(Model?.Count() ?? 0) utilizadores
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function(){
            $("#userSearch").on("keyup", function() {
                var value = $(this).val().toLowerCase();
                $("#usersTable tbody tr").filter(function() {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
                });
            });
        });
    </script>
}
