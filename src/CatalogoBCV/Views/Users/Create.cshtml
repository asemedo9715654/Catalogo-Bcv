@using CatalogoBCV.Models
@model CatalogoBCV.Models.User

@{
    ViewData["Title"] = "Novo Utilizador";
}

@section ContentHeader {
    <div class="app-content-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-6">
                    <h3 class="mb-0">Novo Utilizador</h3>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-end">
                        <li class="breadcrumb-item"><a asp-action="Index">Utilizadores</a></li>
                        <li class="breadcrumb-item active">Novo Utilizador</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>
}

<div class="app-content">
    <div class="container-fluid">
        <div class="row justify-content-center">
            <div class="col-12">
                <div class="card card-outline card-primary">
                    <div class="card-header">
                        <h3 class="card-title">
                             <i class="bi bi-person-plus me-2"></i> Registo de Utilizador
                        </h3>
                    </div>
                    <form asp-action="Create">
                        <div class="card-body">
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                            
                            <div class="mb-3">
                                <label asp-for="Username" class="form-label">
                                    <i class="bi bi-person me-1"></i> Username
                                </label>
                                <input asp-for="Username" class="form-control" placeholder="Introduza o nome de utilizador" autofocus />
                                <span asp-validation-for="Username" class="text-danger small"></span>
                            </div>
                            
                            <div class="mb-3">
                                <label asp-for="PasswordHash" class="form-label">
                                    <i class="bi bi-key me-1"></i> Password
                                </label>
                                <input asp-for="PasswordHash" type="password" class="form-control" placeholder="Introduza a password" />
                                <span asp-validation-for="PasswordHash" class="text-danger small"></span>
                            </div>
                            
                            <div class="mb-3">
                                <label asp-for="RoleId" class="form-label">
                                    <i class="bi bi-shield-lock me-1"></i> Função
                                </label>
                                <select asp-for="RoleId" asp-items="ViewBag.Roles" class="form-select"></select>
                                <span asp-validation-for="RoleId" class="text-danger small"></span>
                            </div>
                            
                            <div class="mb-3">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" role="switch" asp-for="IsActive">
                                    <label class="form-check-label" asp-for="IsActive">
                                        Conta Ativa
                                    </label>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer bg-transparent">
                            <a asp-action="Index" class="btn btn-default">
                                <i class="bi bi-arrow-left me-1"></i> Cancelar
                            </a>
                            <button type="submit" class="btn btn-primary float-end">
                                <i class="bi bi-save me-1"></i> Criar Utilizador
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
