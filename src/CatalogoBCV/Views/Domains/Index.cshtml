@model IEnumerable<CatalogoBCV.Models.Domain>

@{
    ViewData["Title"] = "Domínios de Dados";
}

@section ContentHeader {
    <div class="app-content-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-6">
                    <h3 class="mb-0">Domínios de Dados</h3>
                </div>
            </div>
        </div>
    </div>
}

<section class="content">
    <div class="container-fluid">
        <!-- Resumo Estatístico -->
        <div class="row mb-3">
            <div class="col-12 col-sm-6 col-md-4">
                <div class="info-box">
                    <span class="info-box-icon bg-indigo elevation-1"><i class="bi bi-globe"></i></span>
                    <div class="info-box-content">
                        <span class="info-box-text">Domínios Definidos</span>
                        <span class="info-box-number">
                            @Model.Count()
                        </span>
                    </div>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-md-4">
                <div class="info-box mb-3">
                    <span class="info-box-icon bg-success elevation-1"><i class="bi bi-table"></i></span>
                    <div class="info-box-content">
                        <span class="info-box-text">Tabelas Associadas</span>
                        <span class="info-box-number">@Model.Sum(d => d.Tables?.Count ?? 0)</span>
                    </div>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-md-4">
                <div class="info-box mb-3">
                    <span class="info-box-icon bg-purple elevation-1"><i class="bi bi-star"></i></span>
                    <div class="info-box-content">
                        <span class="info-box-text">Domínio Mais Popular</span>
                        <span class="info-box-number text-truncate" title="@(Model.OrderByDescending(d => d.Tables?.Count ?? 0).FirstOrDefault()?.Name)">
                             @(Model.OrderByDescending(d => d.Tables?.Count ?? 0).FirstOrDefault()?.Name ?? "-")
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <div class="card card-primary card-outline">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="bi bi-list-check me-2"></i>
                    Lista de Domínios
                </h3>
                <div class="card-tools">
                    <a asp-action="Create" class="btn btn-primary btn-sm">
                        <i class="bi bi-plus-circle me-1"></i> Novo Domínio
                    </a>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Domínio</th>
                                <th>Descrição</th>
                                <th class="text-center">Tabelas</th>
                                <th>Criado em</th>
                                <th>Atualizado em</th>
                                <th class="text-end" style="width: 150px">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model) {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="bg-light rounded p-2 me-3 text-indigo">
                                                <i class="bi bi-globe2 fs-4"></i>
                                            </div>
                                            <div>
                                                <h6 class="mb-0 fw-bold">@item.Name</h6>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="text-muted">
                                            @if(!string.IsNullOrEmpty(item.Description))
                                            {
                                                @item.Description
                                            }
                                            else
                                            {
                                                <span class="fst-italic text-black-50">Sem descrição</span>
                                            }
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-secondary rounded-pill">
                                            @(item.Tables?.Count ?? 0)
                                        </span>
                                    </td>
                                    <td>@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@(item.UpdatedAt.HasValue ? item.UpdatedAt.Value.ToString("dd/MM/yyyy HH:mm") : "-")</td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning" title="Editar">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info" title="Ver Detalhes">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger" title="Apagar">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>