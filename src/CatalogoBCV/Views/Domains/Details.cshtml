@model CatalogoBCV.Models.Domain

@{
    ViewData["Title"] = "Detalhes do Domínio";
}

@section ContentHeader {
    <div class="app-content-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-6">
                    <h3 class="mb-0">Detalhes do Domínio</h3>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-end">
                        <li class="breadcrumb-item"><a asp-action="Index">Domínios</a></li>
                        <li class="breadcrumb-item active">Detalhes</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>
}

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-4">
                <div class="card card-primary card-outline">
                    <div class="card-body box-profile">
                        <h3 class="profile-username text-center">@Model.Name</h3>
                        <p class="text-muted text-center">Domínio de Dados</p>
                        <ul class="list-group list-group-unbordered mb-3">
                            <li class="list-group-item">
                                <b>Tabelas</b> <a class="float-end">@(Model.Tables?.Count ?? 0)</a>
                            </li>
                        </ul>
                        <p class="text-muted">@Model.Description</p>
                        <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary btn-block w-100"><b>Editar</b></a>
                    </div>
                </div>
            </div>
            <div class="col-md-8">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">Tabelas Associadas</h3>
                    </div>
                    <div class="card-body p-0">
                        @if (Model?.Tables != null && Model.Tables.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-striped table-hover">
                                    <thead>
                                        <tr>
                                            <th>Schema</th>
                                            <th>Nome</th>
                                            <th>Descrição</th>
                                            <th style="width: 100px">Ações</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var table in Model.Tables)
                                        {
                                            <tr>
                                                <td>@table.Schema</td>
                                                <td>@table.Name</td>
                                                <td>@table.Description</td>
                                                <td>
                                                    <a asp-controller="Catalog" asp-action="TableDetails" asp-route-id="@table.Id" class="btn btn-sm btn-info" title="Ver Detalhes">
                                                        <i class="bi bi-eye"></i>
                                                    </a>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="p-3 text-center text-muted">
                                Nenhuma tabela associada a este domínio.
                            </div>
                        }
                    </div>
                    <div class="card-footer clearfix">
                        <a asp-action="Index" class="btn btn-secondary">Voltar</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
