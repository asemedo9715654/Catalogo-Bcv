@model CatalogoBCV.Models.Domain

@{
    ViewData["Title"] = "Detalhes do Domínio";
}

@section ContentHeader {
    <div class="app-content-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-6">
                    <h3 class="mb-0">Detalhes do Domínio</h3>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-end">
                        <li class="breadcrumb-item"><a asp-action="Index">Domínios</a></li>
                        <li class="breadcrumb-item active">Detalhes</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>
}

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-4">
                <div class="card card-primary card-outline">
                    <div class="card-body box-profile">
                        <h3 class="profile-username text-center">@Model.Name</h3>
                        <p class="text-muted text-center">Domínio de Dados</p>
                        <ul class="list-group list-group-unbordered mb-3">
                            <li class="list-group-item">
                                <b>Subdomínios</b> <a class="float-end">@(Model.SubDomains?.Count ?? 0)</a>
                            </li>
                            <li class="list-group-item">
                                <b>Tabelas</b> <a class="float-end">@(Model.Tables?.Count ?? 0)</a>
                            </li>
                        </ul>
                        <p class="text-muted">@Model.Description</p>
                        <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary btn-block w-100"><b>Editar</b></a>
                    </div>
                </div>
            </div>
            <div class="col-md-8">
                <div class="card mb-3">
                    <div class="card-header">
                        <h3 class="card-title">Subdomínios</h3>
                        <div class="card-tools">
                            <button type="button" class="btn btn-tool" data-bs-toggle="modal" data-bs-target="#createSubDomainModal" title="Adicionar Subdomínio">
                                <i class="bi bi-plus-lg"></i> Adicionar
                            </button>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        @if (Model?.SubDomains != null && Model.SubDomains.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-striped table-hover">
                                    <thead>
                                        <tr>
                                            <th>Nome</th>
                                            <th>Descrição</th>
                                            <th style="width: 100px">Ações</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var subDomain in Model.SubDomains)
                                        {
                                            <tr>
                                                <td>@subDomain.Name</td>
                                                <td>@subDomain.Description</td>
                                                <td class="text-nowrap">
                                                    <a asp-controller="Domains" asp-action="EditSubDomain" asp-route-id="@subDomain.Id" class="btn btn-sm btn-primary" title="Editar">
                                                        <i class="bi bi-pencil-fill"></i>
                                                    </a>
                                                    <a asp-controller="Domains" asp-action="DeleteSubDomain" asp-route-id="@subDomain.Id" class="btn btn-sm btn-danger" title="Apagar">
                                                        <i class="bi bi-trash-fill"></i>
                                                    </a>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="p-3 text-center text-muted">
                                Nenhum subdomínio associado a este domínio.
                            </div>
                        }
                    </div>
                </div>

                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">Tabelas Associadas</h3>
                    </div>
                    <div class="card-body p-0">
                        @if (Model?.Tables != null && Model.Tables.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-striped table-hover">
                                    <thead>
                                        <tr>
                                            <th>Schema</th>
                                            <th>Nome</th>
                                            <th>Descrição</th>
                                            <th style="width: 100px">Ações</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var table in Model.Tables)
                                        {
                                            <tr>
                                                <td>@table.Schema</td>
                                                <td>@table.Name</td>
                                                <td>@table.Description</td>
                                                <td>
                                                    <a asp-controller="Catalog" asp-action="TableDetails" asp-route-id="@table.Id" class="btn btn-sm btn-info" title="Ver Detalhes">
                                                        <i class="bi bi-eye"></i>
                                                    </a>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="p-3 text-center text-muted">
                                Nenhuma tabela associada a este domínio.
                            </div>
                        }
                    </div>
                    <div class="card-footer clearfix">
                        <a asp-action="Index" class="btn btn-secondary">Voltar</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Modal Create SubDomain -->
<div class="modal fade" id="createSubDomainModal" tabindex="-1" aria-labelledby="createSubDomainModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="createSubDomainModalLabel">Novo Subdomínio</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <partial name="~/Views/Domains/_CreateSubDomain.cshtml" model="new CatalogoBCV.Models.SubDomain { DomainId = Model.Id }" />
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function () {
            // Intercept form submission in the modal
            $(document).on('submit', '#createSubDomainModal form', function (e) {
                e.preventDefault();
                var form = $(this);
                var url = form.attr('action');
                
                // Add debug logging
                console.log('Submitting form to: ' + url);
                
                $.ajax({
                    type: "POST",
                    url: url,
                    data: form.serialize(),
                    headers: { "X-Requested-With": "XMLHttpRequest" },
                    success: function (data) {
                        console.log('Success response received');
                        if (data.success) {
                            // Reload page to show new subdomain
                            location.reload(); 
                        } else {
                            // Replace modal body with partial view (containing errors)
                            $('#createSubDomainModal .modal-content').find('form').replaceWith(data);
                            
                            // Re-parse validation
                            var newForm = $('#createSubDomainModal form');
                            $.validator.unobtrusive.parse(newForm);
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error('Error submitting form:', error);
                        console.error('Status:', status);
                        console.error('Response:', xhr.responseText);
                        
                        var msg = "Ocorreu um erro ao processar o pedido.";
                        if (typeof toastr !== 'undefined') {
                            toastr.error(msg);
                        } else {
                            alert(msg);
                        }
                    }
                });
            });
        });
    </script>
}

