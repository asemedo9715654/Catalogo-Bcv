@model CatalogoBCV.Models.Table

@{
    ViewData["Title"] = "Editar Tabela";
}

@section ContentHeader {
    <div class="app-content-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-6">
                    <h3 class="mb-0">Editar Tabela</h3>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-end">
                        <li class="breadcrumb-item"><a asp-controller="Catalog" asp-action="Index">Catálogo</a></li>
                        <li class="breadcrumb-item"><a asp-controller="Catalog" asp-action="TableDetails" asp-route-id="@Model.Id">Detalhes</a></li>
                        <li class="breadcrumb-item active">Editar</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>
}

<section class="content">
    <div class="container-fluid">
        <div class="row justify-content-center">
            <div class="col-12">
                <div class="card card-primary">
                    <div class="card-header">
                        <h3 class="card-title">@Model.Schema.@Model.Name <small>(@Model.CatalogDatabase.DatabaseName)</small></h3>
                    </div>
                    <form asp-action="EditTable">
                        <div class="card-body">
                            <input type="hidden" asp-for="Id" />
                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                            
                            <div class="form-group mb-3">
                                <label asp-for="Alias" class="form-label"></label>
                                <input asp-for="Alias" class="form-control" />
                                <span asp-validation-for="Alias" class="text-danger"></span>
                            </div>
                            
                            <div class="form-group mb-3">
                                <label asp-for="DomainId" class="control-label">Domínio</label>
                                <select asp-for="DomainId" class="form-control" asp-items="ViewBag.DomainId">
                                    <option value="">-- Selecione um Domínio --</option>
                                </select>
                                <span asp-validation-for="DomainId" class="text-danger"></span>
                            </div>

                            <div class="form-group mb-3">
                                <label asp-for="Status" class="control-label">Status da Tabela</label>
                                <select asp-for="Status" class="form-control" asp-items="Html.GetEnumSelectList<CatalogoBCV.Models.TableStatus>()"></select>
                                <span asp-validation-for="Status" class="text-danger"></span>
                            </div>

                            <div class="form-group form-check mb-3">
                                <input class="form-check-input" asp-for="IsFactTable" />
                                <label class="form-check-label" asp-for="IsFactTable">Tabela de Factos</label>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group mb-3">
                                        <label asp-for="Owner" class="form-label">Owner da Tabela</label>
                                        <input asp-for="Owner" class="form-control" />
                                        <span asp-validation-for="Owner" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group mb-3">
                                        <label asp-for="DataSteward" class="form-label">Data Steward</label>
                                        <input asp-for="DataSteward" class="form-control" />
                                        <span asp-validation-for="DataSteward" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="form-group mb-3">
                                <label asp-for="ConfidentialityLevel" class="control-label">Nível de Confidencialidade</label>
                                <select asp-for="ConfidentialityLevel" class="form-control" asp-items="Html.GetEnumSelectList<CatalogoBCV.Models.ConfidentialityLevel>()"></select>
                                <span asp-validation-for="ConfidentialityLevel" class="text-danger"></span>
                            </div>

                            <div class="card bg-light mb-3">
                                <div class="card-header fw-bold">Impacto</div>
                                <div class="card-body">
                                    <div class="form-group mb-3">
                                        <label asp-for="AffectedReports" class="form-label">Relatórios afetados</label>
                                        <textarea asp-for="AffectedReports" class="form-control" rows="2"></textarea>
                                        <span asp-validation-for="AffectedReports" class="text-danger"></span>
                                    </div>
                                    <div class="form-group mb-3">
                                        <label asp-for="DependentDashboards" class="form-label">Dashboards dependentes</label>
                                        <textarea asp-for="DependentDashboards" class="form-control" rows="2"></textarea>
                                        <span asp-validation-for="DependentDashboards" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="card bg-light mb-3">
                                <div class="card-header fw-bold">Qualidade de Dados</div>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="form-group mb-3">
                                                <label asp-for="LoadFrequency" class="form-label">Frequência de Carga</label>
                                                <input asp-for="LoadFrequency" class="form-control" placeholder="Ex: Diária, Mensal" />
                                                <span asp-validation-for="LoadFrequency" class="text-danger"></span>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group mb-3">
                                                <label asp-for="LastSuccessfulLoad" class="form-label">Última Carga Bem-sucedida</label>
                                                <input asp-for="LastSuccessfulLoad" class="form-control" type="datetime-local" />
                                                <span asp-validation-for="LastSuccessfulLoad" class="text-danger"></span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group mb-3">
                                        <label asp-for="ValidationRules" class="form-label">Regras de Validação</label>
                                        <textarea asp-for="ValidationRules" class="form-control" rows="3" placeholder="Descreva as regras de validação aplicadas a esta tabela..."></textarea>
                                        <span asp-validation-for="ValidationRules" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="form-group mb-3">
                                <label asp-for="Description" class="form-label"></label>
                                <textarea asp-for="Description" class="form-control" rows="5"></textarea>
                                <span asp-validation-for="Description" class="text-danger"></span>
                            </div>
                        </div>
                        
                        <div class="card-footer">
                            <a asp-controller="Catalog" asp-action="TableDetails" asp-route-id="@Model.Id" class="btn btn-secondary">Cancelar</a>
                            <input type="submit" value="Guardar" class="btn btn-primary float-end" />
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
