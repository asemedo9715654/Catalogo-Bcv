@model CatalogoBCV.Models.Table

@{
    ViewData["Title"] = "Editar Tabela";
}

<h1>Editar Tabela</h1>

<h4 class="text-muted mb-4">Tabela: @Model.Schema.@Model.Name (Base: @Model.CatalogDatabase.DatabaseName)</h4>
<hr />
<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card-custom">
            <form asp-action="EditTable">
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                
                <div class="form-group mb-3">
                    <label asp-for="Alias" class="form-label"></label>
                    <input asp-for="Alias" class="form-control" />
                    <span asp-validation-for="Alias" class="text-danger"></span>
                </div>
                
                <div class="form-group mb-3">
                    <label asp-for="DomainId" class="control-label">Domínio</label>
                    <select asp-for="DomainId" class="form-control" asp-items="ViewBag.DomainId">
                        <option value="">-- Selecione um Domínio --</option>
                    </select>
                    <span asp-validation-for="DomainId" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Status" class="control-label">Status da Tabela</label>
                    <select asp-for="Status" class="form-control" asp-items="Html.GetEnumSelectList<CatalogoBCV.Models.TableStatus>()"></select>
                    <span asp-validation-for="Status" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="5"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
                
                <div class="form-group mt-4 d-flex justify-content-between align-items-center">
                    <a asp-controller="Catalog" asp-action="TableDetails" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancelar</a>
                    <input type="submit" value="Guardar" class="btn btn-primary px-4" />
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
