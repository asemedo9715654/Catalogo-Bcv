@model IEnumerable<CatalogoBCV.Models.BusinessTerm>

@{
    ViewData["Title"] = "Glossário de Negócios";
}

<div class="row">
    <div class="col-12">
        <div class="card card-outline card-primary">
            <div class="card-header">
                <h3 class="card-title">Listagem de Termos</h3>
                <div class="card-tools">
                    <button type="button" class="btn btn-tool" data-lte-toggle="card-collapse">
                        <i class="bi bi-plus-lg"></i>
                    </button>
                </div>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <a asp-action="Create" class="btn btn-primary">
                            <i class="bi bi-plus-lg me-1"></i> Novo Termo
                        </a>
                    </div>
                    <div class="col-md-6">
                        <form asp-action="Index" method="get">
                            <div class="input-group">
                                <input type="text" name="searchString" class="form-control" placeholder="Buscar por termo ou definição..." value="@Context.Request.Query["searchString"]" />
                                <button type="submit" class="btn btn-outline-secondary">
                                    <i class="bi bi-search"></i> Buscar
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-striped table-hover text-nowrap">
                        <thead>
                            <tr>
                                <th>@Html.DisplayNameFor(model => model.Term)</th>
                                <th>@Html.DisplayNameFor(model => model.Definition)</th>
                                <th>@Html.DisplayNameFor(model => model.Status)</th>
                                <th>@Html.DisplayNameFor(model => model.Owner)</th>
                                <th class="text-end">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model) {
                                <tr>
                                    <td>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="fw-bold text-decoration-none">@Html.DisplayFor(modelItem => item.Term)</a>
                                    </td>
                                    <td class="text-wrap" style="max-width: 400px;">
                                        @{
                                            var definition = item.Definition;
                                            if (!string.IsNullOrEmpty(definition) && definition.Length > 100)
                                            {
                                                definition = definition.Substring(0, 100) + "...";
                                            }
                                        }
                                        @definition
                                    </td>
                                    <td>
                                        <span class="badge @GetStatusBadgeClass(item.Status)">
                                            @Html.DisplayFor(modelItem => item.Status)
                                        </span>
                                    </td>
                                    <td>@Html.DisplayFor(modelItem => item.Owner)</td>
                                    <td class="text-end">
                                        <div class="btn-group">
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Editar">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="Detalhes">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Excluir">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    string GetStatusBadgeClass(CatalogoBCV.Models.TermStatus status)
    {
        return status switch
        {
            CatalogoBCV.Models.TermStatus.Approved => "bg-success",
            CatalogoBCV.Models.TermStatus.Draft => "bg-warning text-dark",
            CatalogoBCV.Models.TermStatus.Deprecated => "bg-danger",
            CatalogoBCV.Models.TermStatus.Obsolete => "bg-secondary",
            _ => "bg-secondary"
        };
    }
}
