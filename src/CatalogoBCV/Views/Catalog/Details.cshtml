@model CatalogoBCV.Models.CatalogDatabase

@{
    ViewData["Title"] = "Detalhes da Base";
    var totalTables = Model.Tables.Count;
    var totalRows = Model.Tables.Sum(t => t.RowCount ?? 0);
    var lastUpdated = Model.LastUpdated?.ToString("dd/MM/yyyy HH:mm") ?? "N/A";
    var certifiedCount = Model.Tables.Count(t => t.Status == CatalogoBCV.Models.TableStatus.Aprovado);
}

@functions {
    string GetStatusBadge(CatalogoBCV.Models.TableStatus status)
    {
        return status switch
        {
            CatalogoBCV.Models.TableStatus.Rascunho => "<span class='badge bg-warning text-dark'>🟡 Rascunho</span>",
            CatalogoBCV.Models.TableStatus.EmValidacao => "<span class='badge bg-info text-dark'>🔵 Em Validação</span>",
            CatalogoBCV.Models.TableStatus.Aprovado => "<span class='badge bg-success'>🟢 Aprovado</span>",
            CatalogoBCV.Models.TableStatus.Obsoleto => "<span class='badge bg-danger'>🔴 Obsoleto</span>",
            CatalogoBCV.Models.TableStatus.Depreciado => "<span class='badge bg-warning'>⚠️ Depreciado</span>",
            _ => $"<span class='badge bg-secondary'>{status}</span>"
        };
    }
}

<link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" />
<link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.bootstrap5.min.css" />

@section ContentHeader {
    <div class="content-header pb-1">
        <div class="container-fluid">
            <div class="row mb-2 align-items-center">
                <div class="col-sm-6">
                    <h1 class="m-0 fs-3 fw-bold">
                        Detalhes da Base
                    </h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-end">
                        <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Catálogo</a></li>
                        <li class="breadcrumb-item active">@Model.DatabaseName</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>
}

<section class="content">
    <div class="container-fluid">
        <!-- Info Card -->
        <div class="card shadow-sm border-0 mb-4 bg-primary bg-opacity-10">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="bg-primary text-white p-3 rounded-circle me-3">
                        <i class="bi bi-database fs-3"></i>
                    </div>
                    <div>
                        <h2 class="fw-bold text-primary mb-1">@Model.DatabaseName</h2>
                        <div class="text-muted"><i class="bi bi-server me-1"></i>@Model.Server</div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Stats Row -->
        <div class="row mb-4">
            <div class="col-md-3 col-sm-6 col-12">
                <div class="card shadow-sm border-start border-4 border-primary h-100">
                    <div class="card-body p-3 d-flex align-items-center">
                        <div class="bg-primary bg-opacity-10 p-3 rounded-circle me-3">
                            <i class="bi bi-table text-primary fs-4"></i>
                        </div>
                        <div>
                            <span class="text-muted small text-uppercase fw-bold">Total Tabelas</span>
                            <h4 class="mb-0 fw-bold">@totalTables</h4>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6 col-12">
                <div class="card shadow-sm border-start border-4 border-success h-100">
                    <div class="card-body p-3 d-flex align-items-center">
                        <div class="bg-success bg-opacity-10 p-3 rounded-circle me-3">
                            <i class="bi bi-check-circle text-success fs-4"></i>
                        </div>
                        <div>
                            <span class="text-muted small text-uppercase fw-bold">Certificadas</span>
                            <h4 class="mb-0 fw-bold">@certifiedCount</h4>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6 col-12">
                <div class="card shadow-sm border-start border-4 border-info h-100">
                    <div class="card-body p-3 d-flex align-items-center">
                        <div class="bg-info bg-opacity-10 p-3 rounded-circle me-3">
                            <i class="bi bi-list-ol text-info fs-4"></i>
                        </div>
                        <div>
                            <span class="text-muted small text-uppercase fw-bold">Total Registros</span>
                            <h4 class="mb-0 fw-bold">@totalRows.ToString("N0")</h4>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6 col-12">
                <div class="card shadow-sm border-start border-4 border-secondary h-100">
                    <div class="card-body p-3 d-flex align-items-center">
                        <div class="bg-secondary bg-opacity-10 p-3 rounded-circle me-3">
                            <i class="bi bi-clock-history text-secondary fs-4"></i>
                        </div>
                        <div>
                            <span class="text-muted small text-uppercase fw-bold">Atualizado em</span>
                            <h6 class="mb-0 fw-bold">@lastUpdated</h6>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Main Content -->
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 border-0">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-list-task me-2 text-primary"></i>Lista de Tabelas</h5>
                    <div class="d-flex gap-2">
                        <div class="btn-group" role="group" aria-label="Alternar vista">
                            <button type="button" class="btn btn-sm btn-outline-secondary" id="btnGridView">
                                <i class="bi bi-grid-3x3-gap-fill me-1"></i> Vista Grid
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary active" id="btnCardView">
                                <i class="bi bi-list-ul me-1"></i> Vista Lista
                            </button>
                        </div>
                        <div class="input-group input-group-sm" style="width: 250px;">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-search"></i></span>
                            <input type="text" id="tableSearch" class="form-control border-start-0 bg-light" placeholder="Pesquisar tabelas...">
                        </div>
                        <a asp-controller="Graph" asp-action="Index" asp-route-dbId="@Model.Id" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-diagram-3 me-1"></i> Visualizar Gráfico
                        </a>
                        <div class="btn-group">
                            <button type="button" class="btn btn-sm btn-outline-success dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false" data-bs-boundary="viewport">
                                <i class="bi bi-file-earmark-text me-1"></i> Documentação
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" asp-action="GenerateDocumentation" asp-route-id="@Model.Id" asp-route-format="md"><i class="bi bi-markdown me-2"></i>Markdown</a></li>
                                <li><a class="dropdown-item" asp-action="GenerateDocumentation" asp-route-id="@Model.Id" asp-route-format="word"><i class="bi bi-file-word me-2"></i>Word</a></li>
                                <li><a class="dropdown-item" asp-action="GenerateDocumentation" asp-route-id="@Model.Id" asp-route-format="pdf"><i class="bi bi-file-pdf me-2"></i>PDF</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-body p-0">
                <div id="gridView" class="table-responsive">
                    <table class="table table-hover align-middle mb-0" id="tablesTable">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-4">Schema</th>
                                <th>Nome</th>
                                <th>Alias</th>
                                <th>Status</th>
                                <th>Tipo</th>
                                <th class="text-end">Linhas</th>
                                <th>Descrição</th>
                                <th class="text-end pe-4" style="width: 120px">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var table in Model.Tables)
                            {
                                <tr>
                                    <td class="ps-4 text-muted fw-bold small">@table.Schema</td>
                                    <td>
                                        <a asp-action="TableDetails" asp-route-id="@table.Id" class="fw-bold text-decoration-none text-dark">
                                            @table.Name
                                        </a>
                                        @if(table.IsFactTable)
                                        {
                                            <span class="badge bg-light text-dark border ms-1" title="Tabela Fato">F</span>
                                        }
                                    </td>
                                    <td>
                                        @if(!string.IsNullOrEmpty(table.Alias))
                                        {
                                            <span class="text-muted fst-italic">@table.Alias</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        @Html.Raw(GetStatusBadge(table.Status))
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-secondary border">@table.Type</span>
                                    </td>
                                    <td class="text-end font-monospace small">
                                        @(table.RowCount.HasValue ? table.RowCount.Value.ToString("N0") : "-")
                                    </td>
                                    <td class="text-truncate" style="max-width: 200px;" title="@table.Description">
                                        @if(!string.IsNullOrEmpty(table.Description))
                                        {
                                            @table.Description
                                        }
                                        else
                                        {
                                            <span class="text-muted small fst-italic">Sem descrição</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="TableDetails" asp-route-id="@table.Id" class="btn btn-outline-secondary" title="Detalhes" data-bs-toggle="tooltip">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-controller="Graph" asp-action="Index" asp-route-tableId="@table.Id" class="btn btn-outline-secondary" title="Linhagem" data-bs-toggle="tooltip">
                                                <i class="bi bi-diagram-3"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div id="cardView" class="p-3 d-none">
                    <div class="row g-3">
                        @foreach (var table in Model.Tables)
                        {
                            var searchText = (table.Schema + " " + table.Name + " " + (table.Alias ?? "") + " " + (table.Description ?? "")).ToLower();
                            <div class="col-sm-6 col-md-4 col-lg-3 table-card-item" data-search="@searchText">
                                <div class="card h-100 shadow-sm border">
                                    <div class="card-header bg-light d-flex justify-content-between align-items-center">
                                        <div>
                                            <div class="small text-muted fw-bold">@table.Schema</div>
                                            <div class="fw-bold">
                                                <a asp-action="TableDetails" asp-route-id="@table.Id" class="text-decoration-none text-dark">
                                                    @table.Name
                                                </a>
                                                @if (table.IsFactTable)
                                                {
                                                    <span class="badge bg-light text-dark border ms-1" title="Tabela Fato">F</span>
                                                }
                                            </div>
                                        </div>
                                        <div class="ms-auto text-end">
                                            @Html.Raw(GetStatusBadge(table.Status))
                                            <div>
                                                <span class="badge bg-light text-secondary border mt-1">@table.Type</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="card-body">
                                        <div class="mb-2">
                                            <span class="text-muted small text-uppercase">Alias:</span>
                                            @if (!string.IsNullOrEmpty(table.Alias))
                                            {
                                                <span class="ms-1 fst-italic">@table.Alias</span>
                                            }
                                            else
                                            {
                                                <span class="ms-1 text-muted">-</span>
                                            }
                                        </div>
                                        <div class="mb-2">
                                            <span class="text-muted small text-uppercase">Descrição:</span>
                                            @if (!string.IsNullOrEmpty(table.Description))
                                            {
                                                <div class="small mt-1">@table.Description</div>
                                            }
                                            else
                                            {
                                                <div class="small mt-1 text-muted fst-italic">Sem descrição</div>
                                            }
                                        </div>
                                    </div>
                                    <div class="card-footer d-flex align-items-center bg-white">
                                        <div class="small text-muted">
                                            <i class="bi bi-list-ol me-1"></i>
                                            @(table.RowCount.HasValue ? table.RowCount.Value.ToString("N0") : "-") registos
                                        </div>
                                        <div class="btn-group btn-group-sm ms-auto">
                                            <a asp-action="TableDetails" asp-route-id="@table.Id" class="btn btn-outline-secondary" title="Detalhes" data-bs-toggle="tooltip">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-controller="Graph" asp-action="Index" asp-route-tableId="@table.Id" class="btn btn-outline-secondary" title="Linhagem" data-bs-toggle="tooltip">
                                                <i class="bi bi-diagram-3"></i>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="card-footer bg-white py-3">
                 <div class="d-flex justify-content-between align-items-center">
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Voltar</a>
                    <small class="text-muted">Mostrando @totalTables tabelas</small>
                 </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/responsive.bootstrap5.min.js"></script>

    <script>
        $(document).ready(function(){
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });

            var tablesTable = $('#tablesTable').DataTable({
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.13.7/i18n/pt-PT.json"
                },
                "paging": true,
                "lengthChange": false,
                "pageLength": 10,
                "ordering": true,
                "info": true,
                "autoWidth": false,
                "responsive": true,
                "dom": 'rt<"row"<"col-sm-12 col-md-5"i><"col-sm-12 col-md-7"p>>'
            });

            $("#tableSearch").on("keyup", function() {
                var value = this.value;
                tablesTable.search(value).draw();

                var query = value.toLowerCase();
                $("#cardView .table-card-item").each(function () {
                    var text = ($(this).data("search") || "").toString();
                    if (query === "" || text.indexOf(query) !== -1) {
                        $(this).removeClass("d-none");
                    } else {
                        $(this).addClass("d-none");
                    }
                });
            });

            $("#btnGridView").on("click", function () {
                $("#gridView").addClass("d-none");
                $("#cardView").removeClass("d-none");
                $("#btnGridView").addClass("active");
                $("#btnCardView").removeClass("active");
            });

            $("#btnCardView").on("click", function () {
                $("#gridView").removeClass("d-none");
                $("#cardView").addClass("d-none");
                $("#btnCardView").addClass("active");
                $("#btnGridView").removeClass("active");
            });
        });
    </script>
}
