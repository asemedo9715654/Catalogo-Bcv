@model IEnumerable<CatalogoBCV.Models.CatalogDatabase>

@{
    ViewData["Title"] = "Catálogo de Bases de Dados";
}

@section ContentHeader {
    <div class="app-content-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-6">
                    <h3 class="mb-0">Catálogo de Bases de Dados</h3>
                </div>
            </div>
        </div>
    </div>
}

<section class="content">
    <div class="container-fluid">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["InfoMessage"] != null)
        {
            <div class="alert alert-info alert-dismissible fade show" role="alert">
                @TempData["InfoMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- Resumo Estatístico -->
        <div class="row mb-3">
            <div class="col-12 col-sm-6 col-md-3">
                <div class="info-box">
                    <span class="info-box-icon bg-info elevation-1"><i class="bi bi-database"></i></span>
                    <div class="info-box-content">
                        <span class="info-box-text">Bases de Dados</span>
                        <span class="info-box-number">
                            @Model.Count()
                        </span>
                    </div>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-md-3">
                <div class="info-box mb-3">
                    <span class="info-box-icon bg-success elevation-1"><i class="bi bi-table"></i></span>
                    <div class="info-box-content">
                        <span class="info-box-text">Total de Tabelas</span>
                        <span class="info-box-number">@Model.Sum(db => db.Tables?.Count ?? 0)</span>
                    </div>
                </div>
            </div>
             <div class="col-12 col-sm-6 col-md-3">
                <div class="info-box mb-3">
                    <span class="info-box-icon bg-warning elevation-1"><i class="bi bi-clock-history"></i></span>
                    <div class="info-box-content">
                        <span class="info-box-text">Última Atualização</span>
                        <span class="info-box-number text-muted" style="font-size: 0.9rem;">
                             @(Model.OrderByDescending(d => d.LastUpdated).FirstOrDefault()?.LastUpdated?.ToString("g") ?? "-")
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <div class="card card-primary card-outline">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="bi bi-list-ul me-2"></i>
                    Lista de Bases de Dados
                </h3>
                <div class="card-tools">
                    @if (User.HasClaim("permission", "CanCreateCatalog"))
                    {
                        <a asp-action="Create" class="btn btn-primary btn-sm">
                            <i class="bi bi-plus-circle me-1"></i> Nova Conexão
                        </a>
                    }
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive" style="overflow: visible;">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Servidor / Base</th>
                                <th class="text-center">Tabelas</th>
                                <th>Autenticação</th>
                                <th>Datas</th>
                                <th class="text-end" style="width: 150px">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model) {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="bg-light rounded p-2 me-3 text-primary">
                                                <i class="bi bi-database-fill fs-4"></i>
                                            </div>
                                            <div>
                                                <h6 class="mb-0 fw-bold">@item.DatabaseName</h6>
                                                <small class="text-muted"><i class="bi bi-hdd-network me-1"></i> @item.Server</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-secondary rounded-pill">
                                            @(item.Tables?.Count ?? 0)
                                        </span>
                                    </td>
                                    <td>
                                        <small class="d-block text-muted">
                                            @if (item.UseWindowsAuthentication)
                                            {
                                                <span class="badge bg-info text-dark"><i class="bi bi-windows me-1"></i> Windows Auth</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark"><i class="bi bi-person-badge me-1"></i> SQL Auth</span>
                                                <div class="mt-1 text-muted small">User: @item.Username</div>
                                            }
                                        </small>
                                    </td>
                                    <td>
                                        <small class="d-block text-muted">Criado: @item.CreatedAt.ToString("d")</small>
                                        <small class="d-block text-primary">Atualizado: @item.LastUpdated?.ToString("g")</small>
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <div class="btn-group">
                                                <button type="button" class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false" title="Gerar Documentação">
                                                    <i class="bi bi-file-earmark-text"></i>
                                                </button>
                                                <ul class="dropdown-menu dropdown-menu-end">
                                                    <li><a class="dropdown-item" asp-action="GenerateDocumentation" asp-route-id="@item.Id" asp-route-format="md"><i class="bi bi-markdown me-2"></i>Markdown</a></li>
                                                    <li><a class="dropdown-item" asp-action="GenerateDocumentation" asp-route-id="@item.Id" asp-route-format="word"><i class="bi bi-file-word me-2"></i>Word</a></li>
                                                    <li><a class="dropdown-item" asp-action="GenerateDocumentation" asp-route-id="@item.Id" asp-route-format="pdf"><i class="bi bi-file-pdf me-2"></i>PDF</a></li>
                                                </ul>
                                            </div>
                                            <a asp-action="Update" asp-route-id="@item.Id" class="btn btn-outline-success" title="Atualizar Metadados" onclick="return confirm('Deseja atualizar os metadados desta base de dados?');">
                                                <i class="bi bi-arrow-repeat"></i>
                                            </a>
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info" title="Ver Detalhes">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-controller="Graph" asp-action="Index" asp-route-dbId="@item.Id" class="btn btn-outline-warning" title="Visualizar Gráfico">
                                                <i class="bi bi-diagram-3"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>
