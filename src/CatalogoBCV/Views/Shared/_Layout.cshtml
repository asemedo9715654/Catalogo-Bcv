@using Microsoft.AspNetCore.Authorization
@inject CatalogoBCV.Services.ISettingsService SettingsService
@inject IAuthorizationService AuthorizationService
@{
    var appTitle = await SettingsService.GetSettingAsync("AppTitle", "CatalogoBCV");
    var theme = await SettingsService.GetSettingAsync("Theme", "light");
    var primaryColor = await SettingsService.GetSettingAsync("PrimaryColor", "#0d6efd");
    var headerColor = await SettingsService.GetSettingAsync("HeaderColor", "#ffffff");
    var sidebarColor = await SettingsService.GetSettingAsync("SidebarColor", "#f8f9fa");
    var logoPath = await SettingsService.GetSettingAsync("LogoPath", "~/images/logo.png");

    var bodyClass = theme == "dark" ? "layout-fixed sidebar-expand-lg bg-body-tertiary dark-mode" : "layout-fixed sidebar-expand-lg bg-body-tertiary";
    // If adminlte uses data-bs-theme attribute, we might want to set that on html or body.
    // Based on previous code, there was a dark mode toggle that probably toggles a class or attribute.
    // Let's assume 'dark-mode' class on body or data-bs-theme="dark" on body.
    // Checking adminlte v4 docs or usage, it often uses data-bs-theme="dark".

    var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();

    string IsActive(string controller, string? action = null)
    {
        if (string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase))
        {
            if (action == null || string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase))
            {
                return "active";
            }
        }
        return "";
    }
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="@theme">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @appTitle</title>
    <link rel="icon" href="@Url.Content(logoPath)" />
    
    <style>
        :root {
            --bs-primary: @primaryColor;
            --bs-primary-rgb: @System.Drawing.ColorTranslator.FromHtml(primaryColor).R, @System.Drawing.ColorTranslator.FromHtml(primaryColor).G, @System.Drawing.ColorTranslator.FromHtml(primaryColor).B;
            --app-header-bg: @headerColor;
            --app-sidebar-bg: @sidebarColor;
        }
        
        .app-header {
            background-color: var(--app-header-bg) !important;
        }
        
        .app-sidebar {
            background-color: var(--app-sidebar-bg) !important;
        }
        
        .btn-primary {
            background-color: var(--bs-primary) !important;
            border-color: var(--bs-primary) !important;
        }
        
        .text-bg-primary {
            background-color: var(--bs-primary) !important;
        }
    </style>
    
    <!-- Fonts -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@fontsource/source-sans-3@5.0.12/index.css" />
    
    <!-- OverlayScrollbars -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/overlayscrollbars@2.3.0/styles/overlayscrollbars.min.css" />
    
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.min.css" />
    
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- AdminLTE CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@4.0.0-beta1/dist/css/adminlte.min.css" />
    
    <!-- Toastr CSS -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
    
    <!-- Local CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CatalogoBCV.styles.css" asp-append-version="true" />
</head>
<body class="layout-fixed sidebar-expand-lg bg-body-tertiary app-compact">
    <div class="app-wrapper">
        <!-- Header -->
        <nav class="app-header navbar navbar-expand bg-body">
            <div class="container-fluid">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link" data-lte-toggle="sidebar" href="#" role="button">
                            <i class="bi bi-list"></i>
                        </a>
                    </li>
                    <li class="nav-item d-none d-md-block">
                        <a href="@Url.Action("Index", "Home")" class="nav-link">Home</a>
                    </li>
                </ul>

                <ul class="navbar-nav ms-auto">
                    <!-- Dark Mode Toggle -->
                    <li class="nav-item">
                        <button class="nav-link btn btn-link" id="darkModeToggle" title="Alternar Modo Escuro">
                            <i class="bi bi-moon-stars"></i>
                        </button>
                    </li>

                    <!-- Search Form -->
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item d-none d-md-block">
                             <form class="d-flex position-relative app-search">
                                <div class="input-group">
                                    <input class="form-control" type="search" placeholder="Pesquisar..." aria-label="Search" id="globalSearchInput" autocomplete="off">
                                    <button class="btn btn-outline-secondary" type="button">
                                        <i class="bi bi-search"></i>
                                    </button>
                                </div>
                                <div id="searchResults" class="list-group position-absolute w-100 shadow" style="top: 100%; z-index: 1050; display: none; max-height: 400px; overflow-y: auto;"></div>
                            </form>
                        </li>
                    }

                    <!-- User Menu -->
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item dropdown user-menu">
                            <a href="#" class="nav-link dropdown-toggle" data-bs-toggle="dropdown">
                                <i class="bi bi-person-circle"></i>
                                <span class="d-none d-md-inline ms-1">@User.Identity.Name</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-lg dropdown-menu-end">
                                <li class="user-header text-bg-primary">
                                    <i class="bi bi-person-circle display-1"></i>
                                    <p>
                                        @User.Identity.Name
                                        <small>Utilizador</small>
                                    </p>
                                </li>
                                <li class="user-footer">
                                    <a asp-controller="Account" asp-action="Logout" class="btn btn-default btn-flat float-end">Sair</a>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                         <li class="nav-item">
                            <a asp-controller="Account" asp-action="Login" class="nav-link">Entrar</a>
                        </li>
                    }
                </ul>
            </div>
        </nav>

        <!-- Sidebar -->
        <aside class="app-sidebar bg-body-secondary shadow" data-bs-theme="@theme">
            <div class="sidebar-brand">
                <a href="@Url.Action("Index", "Home")" class="brand-link">
                    <img src="@Url.Content(logoPath)" alt="@appTitle Logo" class="brand-image opacity-75 shadow" style="max-height: 33px;">
                    <span class="brand-text fw-light">@appTitle</span>
                </a>
            </div>
            <div class="sidebar-wrapper">
                <nav class="mt-2">
                    <ul class="nav sidebar-menu flex-column" data-lte-toggle="treeview" role="menu" data-accordion="false">
                        <li class="nav-item">
                            <a asp-controller="Home" asp-action="Index" class="nav-link @IsActive("Home")">
                                <i class="nav-icon bi bi-speedometer"></i>
                                <p>Home</p>
                            </a>
                        </li>
                        @if ((await AuthorizationService.AuthorizeAsync(User, "CanViewCatalog")).Succeeded)
                        {
                            <li class="nav-item">
                                <a asp-controller="Catalog" asp-action="Index" class="nav-link @IsActive("Catalog")">
                                    <i class="nav-icon bi bi-database"></i>
                                    <p>Catálogo</p>
                                </a>
                            </li>
                        }
                        @if ((await AuthorizationService.AuthorizeAsync(User, "CanViewCatalog")).Succeeded)
                        {
                            <li class="nav-item">
                                <a asp-controller="Domains" asp-action="Index" class="nav-link @IsActive("Domains")">
                                    <i class="nav-icon bi bi-globe"></i>
                                    <p>Domínios</p>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-controller="SourceSystems" asp-action="Index" class="nav-link @IsActive("SourceSystems")">
                                    <i class="nav-icon bi bi-server"></i>
                                    <p>Sistemas de Origem</p>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-controller="BusinessTerms" asp-action="Index" class="nav-link @IsActive("BusinessTerms")">
                                    <i class="nav-icon bi bi-book"></i>
                                    <p>Glossário de Negócios</p>
                                </a>
                            </li>
                        }
                        @if ((await AuthorizationService.AuthorizeAsync(User, "CanViewAudit")).Succeeded)
                        {
                            <li class="nav-item">
                                <a asp-controller="Audit" asp-action="Index" class="nav-link @IsActive("Audit")">
                                    <i class="nav-icon bi bi-journal-text"></i>
                                    <p>Auditoria</p>
                                </a>
                            </li>
                        }
                        @{
                            var canManageUsers = (await AuthorizationService.AuthorizeAsync(User, "CanManageUsers")).Succeeded;
                            var canManageRoles = (await AuthorizationService.AuthorizeAsync(User, "CanManageRoles")).Succeeded;
                            var canManageSettings = (await AuthorizationService.AuthorizeAsync(User, "CanManageSettings")).Succeeded;
                        }
                        @if (canManageUsers || canManageRoles || canManageSettings)
                        {
                            <li class="nav-header">ADMINISTRAÇÃO</li>
                            @if (canManageUsers)
                            {
                                <li class="nav-item @(IsActive("Users") == "active" ? "menu-open" : "")">
                                    <a href="#" class="nav-link @IsActive("Users")">
                                        <i class="nav-icon bi bi-people"></i>
                                        <p>
                                            Utilizadores
                                            <i class="nav-arrow bi bi-chevron-right"></i>
                                        </p>
                                    </a>
                                    <ul class="nav nav-treeview">
                                        <li class="nav-item">
                                            <a asp-controller="Users" asp-action="Index" class="nav-link @(IsActive("Users", "Index") == "active" ? "active" : "")">
                                                <i class="nav-icon bi bi-list-ul"></i>
                                                <p>Lista de Utilizadores</p>
                                            </a>
                                        </li>
                                        <li class="nav-item">
                                            <a asp-controller="Users" asp-action="Metrics" class="nav-link @(IsActive("Users", "Metrics") == "active" ? "active" : "")">
                                                <i class="nav-icon bi bi-bar-chart"></i>
                                                <p>Métricas</p>
                                            </a>
                                        </li>
                                    </ul>
                                </li>
                            }
                            @if (canManageRoles)
                            {
                                <li class="nav-item">
                                    <a asp-controller="Roles" asp-action="Index" class="nav-link @IsActive("Roles")">
                                        <i class="nav-icon bi bi-shield-lock"></i>
                                        <p>Roles</p>
                                    </a>
                                </li>
                            }
                            @if (canManageSettings)
                            {
                                <li class="nav-item">
                                    <a asp-controller="Settings" asp-action="Index" class="nav-link @IsActive("Settings")">
                                        <i class="nav-icon bi bi-gear"></i>
                                        <p>Configurações</p>
                                    </a>
                                </li>
                            }
                        }
                    </ul>
                </nav>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="app-main">
            @if (IsSectionDefined("ContentHeader"))
            {
                @RenderSection("ContentHeader", required: false)
            }
            else
            {
                <div class="app-content-header">
                    <div class="container-fluid">
                        <div class="row">
                            <div class="col-sm-6">
                                <h3 class="mb-0">@ViewData["Title"]</h3>
                            </div>
                            <div class="col-sm-6">
                                <ol class="breadcrumb float-sm-end">
                                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                                    <li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            }
            <div class="app-content">
                <div class="container-fluid">
                    @RenderBody()
                </div>
            </div>
        </main>

        <!-- Footer -->
        <footer class="app-footer">
            <div class="float-end d-none d-sm-inline">@appTitle</div>
            <strong>&copy; 2026 <a href="#">@appTitle</a>.</strong> All rights reserved.
        </footer>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/overlayscrollbars@2.3.0/browser/overlayscrollbars.browser.es6.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@popperjs/core@2.11.8/dist/umd/popper.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/admin-lte@4.0.0-beta1/dist/js/adminlte.min.js"></script>
    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <!-- Toastr JS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

    <script>
        // Dark Mode Logic
        (function() {
            const toggleButton = document.getElementById('darkModeToggle');
            const icon = toggleButton.querySelector('i');
            const htmlElement = document.documentElement;
            
            // Check localStorage or system preference
            const savedTheme = localStorage.getItem('theme');
            const systemTheme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            const currentTheme = savedTheme || systemTheme;
            
            // Apply theme
            if (currentTheme === 'dark') {
                htmlElement.setAttribute('data-bs-theme', 'dark');
                icon.classList.remove('bi-moon-stars');
                icon.classList.add('bi-sun');
            } else {
                htmlElement.setAttribute('data-bs-theme', 'light');
                icon.classList.remove('bi-sun');
                icon.classList.add('bi-moon-stars');
            }

            // Toggle event
            toggleButton.addEventListener('click', function() {
                const isDark = htmlElement.getAttribute('data-bs-theme') === 'dark';
                const newTheme = isDark ? 'light' : 'dark';
                
                htmlElement.setAttribute('data-bs-theme', newTheme);
                localStorage.setItem('theme', newTheme);
                
                if (newTheme === 'dark') {
                    icon.classList.remove('bi-moon-stars');
                    icon.classList.add('bi-sun');
                } else {
                    icon.classList.remove('bi-sun');
                    icon.classList.add('bi-moon-stars');
                }
            });
        })();

        $(document).ready(function() {
            toastr.options = {
                "closeButton": true,
                "progressBar": true,
                "positionClass": "toast-top-right",
                "timeOut": "5000"
            };

            @if (TempData["Success"] != null)
            {
                <text>toastr.success('@TempData["Success"]');</text>
            }
            @if (TempData["Error"] != null)
            {
                <text>toastr.error('@TempData["Error"]');</text>
            }
            @if (TempData["Warning"] != null)
            {
                <text>toastr.warning('@TempData["Warning"]');</text>
            }
            @if (TempData["Info"] != null)
            {
                <text>toastr.info('@TempData["Info"]');</text>
            }
        });
    </script>
    
    <script>
        var appBaseUrl = '@Url.Content("~/")';
    </script>
    
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    
    <script>
        const SELECTOR_SIDEBAR_WRAPPER = ".sidebar-wrapper";
        const Default = {
            scrollbarTheme: "os-theme-light",
            scrollbarAutoHide: "leave",
            scrollbarClickScroll: true,
        };
        document.addEventListener("DOMContentLoaded", function() {
            const sidebarWrapper = document.querySelector(SELECTOR_SIDEBAR_WRAPPER);
            if (
                sidebarWrapper &&
                typeof OverlayScrollbarsGlobal?.OverlayScrollbars !== "undefined"
            ) {
                OverlayScrollbarsGlobal.OverlayScrollbars(sidebarWrapper, {
                    scrollbars: {
                        theme: Default.scrollbarTheme,
                        autoHide: Default.scrollbarAutoHide,
                        clickScroll: Default.scrollbarClickScroll,
                    },
                });
            }
        });
    </script>
</body>
</html>
