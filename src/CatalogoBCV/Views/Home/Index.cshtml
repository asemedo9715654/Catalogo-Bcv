@model CatalogoBCV.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css">

@section ContentHeader {
    <div class="app-content-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-6">
                    <h3 class="mb-0">Dashboard</h3>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-end">
                        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                        <li class="breadcrumb-item active">Dashboard</li>
                    </ol>
                </div>
            </div>
            <div class="row mt-2">
                 <div class="col-12 text-end">
                    <a asp-controller="Catalog" asp-action="Create" class="btn btn-primary btn-sm">
                        <i class="fas fa-plus fa-sm text-white-50"></i> Nova Base de Dados
                    </a>
                </div>
            </div>
        </div>
    </div>
}

<div class="container-fluid">

    <!-- Stats Cards -->
    <div class="row">
        <!-- Databases Card -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                                Bases de Dados</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.TotalDatabases</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-database fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tables Card -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-success shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                                Tabelas</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.TotalTables</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-table fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Columns Card -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-info shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-info text-uppercase mb-1">Documentação
                            </div>
                            <div class="row no-gutters align-items-center">
                                <div class="col-auto">
                                    <div class="h5 mb-0 mr-3 font-weight-bold text-gray-800">@Model.DocumentationPercentage%</div>
                                </div>
                                <div class="col">
                                    <div class="progress progress-sm mr-2">
                                        <div class="progress-bar bg-info" role="progressbar"
                                            style="width: @Model.DocumentationPercentage%" aria-valuenow="@Model.DocumentationPercentage" aria-valuemin="0"
                                            aria-valuemax="100"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-clipboard-list fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Users Card -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-warning shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                                Utilizadores</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.TotalUsers</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-users fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Activity & Quick Actions -->
    <div class="row">
        <!-- Recent Activity -->
        <div class="col-lg-8 mb-4">
            <div class="card shadow mb-4">
                <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                    <h6 class="m-0 font-weight-bold text-primary">Atividade Recente</h6>
                    <a asp-controller="Audit" asp-action="Index" class="btn btn-sm btn-link">Ver Tudo</a>
                </div>
                <div class="card-body">
                    @if (Model.RecentActivities.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var log in Model.RecentActivities)
                            {
                                <div class="list-group-item px-0">
                                    <div class="d-flex align-items-center justify-content-between">
                                        <div>
                                            <i class="fas fa-history text-gray-400 mr-2"></i>
                                            <span class="font-weight-bold">@log.Username</span>
                                            <span class="text-muted small">@log.Action</span>
                                            <span class="text-primary small">@log.EntityType: @log.EntityId</span>
                                        </div>
                                        <small class="text-muted">@log.Timestamp.ToString("g")</small>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-center my-3">Nenhuma atividade recente encontrada.</p>
                    }
                </div>
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="col-lg-4 mb-4">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Ações Rápidas</h6>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a asp-controller="Catalog" asp-action="Index" class="btn btn-outline-primary btn-block text-start mb-2">
                            <i class="fas fa-search me-2"></i> Pesquisar Catálogo
                        </a>
                        <a asp-controller="Domains" asp-action="Index" class="btn btn-outline-info btn-block text-start mb-2">
                            <i class="fas fa-layer-group me-2"></i> Gerir Domínios
                        </a>
                        <a asp-controller="Audit" asp-action="Index" class="btn btn-outline-secondary btn-block text-start">
                            <i class="fas fa-shield-alt me-2"></i> Logs de Auditoria
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Top Domains Chart -->
        <div class="col-lg-6 mb-4">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Top Domínios (Tabelas)</h6>
                </div>
                <div class="card-body">
                    @if (Model.TopDomains.Any())
                    {
                        <div class="chart-pie pt-4 pb-2">
                            <canvas id="domainsChart"></canvas>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">Nenhum domínio definido.</p>
                    }
                </div>
            </div>
        </div>

        <!-- Table Distribution Chart -->
        <div class="col-lg-6 mb-4">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Distribuição de Tabelas</h6>
                </div>
                <div class="card-body">
                    @if (Model.TotalTables > 0)
                    {
                        <div class="chart-pie pt-4 pb-2">
                            <canvas id="tablesDistributionChart"></canvas>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">Nenhuma tabela catalogada.</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Databases Status -->
        <div class="col-lg-6 mb-4">
            <div class="card shadow mb-4">
                <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                    <h6 class="m-0 font-weight-bold text-primary">Estado das Bases de Dados</h6>
                </div>
                <div class="card-body">
                    @if (Model.DatabasesStatus.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-bordered table-sm" width="100%" cellspacing="0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Servidor</th>
                                        <th>Base de Dados</th>
                                        <th>Última Atualização</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var db in Model.DatabasesStatus)
                                    {
                                        <tr>
                                            <td><small>@db.Server</small></td>
                                            <td><a asp-controller="Catalog" asp-action="Details" asp-route-id="@db.Id">@db.DatabaseName</a></td>
                                            <td><small>@db.UpdatedAt?.ToString("g")</small></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-3">
                            <p class="text-muted mb-3">Nenhuma base de dados catalogada.</p>
                            <a asp-controller="Catalog" asp-action="Create" class="btn btn-primary btn-sm">
                                <i class="fas fa-plus"></i> Adicionar Base de Dados
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Largest Tables -->
        <div class="col-lg-6 mb-4">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Maiores Tabelas (por linhas)</h6>
                </div>
                <div class="card-body">
                     @if (Model.LargestTables.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-bordered table-sm" width="100%" cellspacing="0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Tabela</th>
                                        <th>BD</th>
                                        <th>Linhas</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var table in Model.LargestTables)
                                    {
                                        <tr>
                                            <td>@table.TableName</td>
                                            <td><small>@table.DatabaseName</small></td>
                                            <td class="text-end">@table.RowCount.ToString("N0")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">Sem dados de contagem de linhas.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .border-left-primary { border-left: .25rem solid #4e73df!important; }
    .border-left-success { border-left: .25rem solid #1cc88a!important; }
    .border-left-info { border-left: .25rem solid #36b9cc!important; }
    .border-left-warning { border-left: .25rem solid #f6c23e!important; }
    .text-gray-300 { color: #dddfeb!important; }
    .text-gray-400 { color: #d1d3e2!important; }
    .text-gray-800 { color: #5a5c69!important; }
    .chart-pie {
        position: relative;
        height: 20rem;
        width: 100%;
    }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Set new default font family and font color to mimic Bootstrap's default styling
        Chart.defaults.font.family = 'Nunito, -apple-system,system-ui,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif';
        Chart.defaults.color = '#858796';

        // Top Domains Chart
        var ctxDomains = document.getElementById("domainsChart");
        if (ctxDomains) {
            var domainsData = @Html.Raw(Json.Serialize(Model.TopDomains.Select(d => d.TableCount)));
            var domainsLabels = @Html.Raw(Json.Serialize(Model.TopDomains.Select(d => d.Name)));
            
            new Chart(ctxDomains, {
                type: 'doughnut',
                data: {
                    labels: domainsLabels,
                    datasets: [{
                        data: domainsData,
                        backgroundColor: ['#4e73df', '#1cc88a', '#36b9cc', '#f6c23e', '#e74a3b'],
                        hoverBackgroundColor: ['#2e59d9', '#17a673', '#2c9faf', '#dda20a', '#be2617'],
                        hoverBorderColor: "rgba(234, 236, 244, 1)",
                    }],
                },
                options: {
                    maintainAspectRatio: false,
                    tooltips: {
                        backgroundColor: "rgb(255,255,255)",
                        bodyColor: "#858796",
                        borderColor: '#dddfeb',
                        borderWidth: 1,
                        xPadding: 15,
                        yPadding: 15,
                        displayColors: false,
                        caretPadding: 10,
                    },
                    legend: {
                        display: true,
                        position: 'bottom'
                    },
                    cutout: '70%',
                },
            });
        }

        // Table Distribution Chart
        var ctxTables = document.getElementById("tablesDistributionChart");
        if (ctxTables) {
            new Chart(ctxTables, {
                type: 'pie',
                data: {
                    labels: ["Facto", "Dimensões / Outras"],
                    datasets: [{
                        data: [@Model.FactTablesCount, @Model.DimensionTablesCount],
                        backgroundColor: ['#e74a3b', '#f6c23e'],
                        hoverBackgroundColor: ['#be2617', '#dda20a'],
                        hoverBorderColor: "rgba(234, 236, 244, 1)",
                    }],
                },
                options: {
                    maintainAspectRatio: false,
                    tooltips: {
                        backgroundColor: "rgb(255,255,255)",
                        bodyColor: "#858796",
                        borderColor: '#dddfeb',
                        borderWidth: 1,
                        xPadding: 15,
                        yPadding: 15,
                        displayColors: false,
                        caretPadding: 10,
                    },
                    legend: {
                        display: true,
                        position: 'bottom'
                    },
                },
            });
        }
    </script>
}
