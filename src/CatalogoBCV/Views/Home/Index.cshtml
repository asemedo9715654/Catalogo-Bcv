@model CatalogoBCV.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css">

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">Dashboard</h1>
        <a asp-controller="Catalog" asp-action="Create" class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm">
            <i class="fas fa-plus fa-sm text-white-50"></i> Nova Base de Dados
        </a>
    </div>

    <!-- Stats Cards -->
    <div class="row">
        <!-- Databases Card -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                                Bases de Dados</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.TotalDatabases</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-database fa-2x text-gray-300" style="color: #dddfeb;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tables Card -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-success shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                                Tabelas</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.TotalTables</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-table fa-2x text-gray-300" style="color: #dddfeb;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Columns Card -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-info shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-info text-uppercase mb-1">Documentação
                            </div>
                            <div class="row no-gutters align-items-center">
                                <div class="col-auto">
                                    <div class="h5 mb-0 mr-3 font-weight-bold text-gray-800">@Model.DocumentationPercentage%</div>
                                </div>
                                <div class="col">
                                    <div class="progress progress-sm mr-2">
                                        <div class="progress-bar bg-info" role="progressbar"
                                            style="width: @Model.DocumentationPercentage%" aria-valuenow="@Model.DocumentationPercentage" aria-valuemin="0"
                                            aria-valuemax="100"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-clipboard-list fa-2x text-gray-300" style="color: #dddfeb;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Users Card -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-warning shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                                Utilizadores</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.TotalUsers</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-users fa-2x text-gray-300" style="color: #dddfeb;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Content Column -->
        <div class="col-lg-6 mb-4">
            <!-- Project Card Example -->
            <div class="card shadow mb-4">
                <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                    <h6 class="m-0 font-weight-bold text-primary">Estado das Bases de Dados</h6>
                </div>
                <div class="card-body">
                    @if (Model.DatabasesStatus.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-bordered" width="100%" cellspacing="0">
                                <thead>
                                    <tr>
                                        <th>Servidor</th>
                                        <th>Base de Dados</th>
                                        <th>Última Atualização</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var db in Model.DatabasesStatus)
                                    {
                                        <tr>
                                            <td>@db.Server</td>
                                            <td>@db.DatabaseName</td>
                                            <td>@db.LastUpdated?.ToString("g")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-3">
                            <p class="text-muted mb-3">Nenhuma base de dados catalogada.</p>
                            <a asp-controller="Catalog" asp-action="Create" class="btn btn-primary btn-sm">
                                <i class="fas fa-plus"></i> Adicionar Base de Dados
                            </a>
                        </div>
                    }
                </div>
            </div>

            <!-- Top Domains -->
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Top Domínios</h6>
                </div>
                <div class="card-body">
                    @if (Model.TopDomains.Any())
                    {
                        @foreach (var domain in Model.TopDomains)
                        {
                            <h4 class="small font-weight-bold">@domain.Name <span
                                    class="float-right">@domain.TableCount tabelas</span></h4>
                            <div class="progress mb-4">
                                @{
                                    var percentage = (double)domain.TableCount / Model.TotalTables * 100;
                                }
                                <div class="progress-bar bg-primary" role="progressbar" style="width: @percentage%"
                                    aria-valuenow="@percentage" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted">Nenhum domínio definido.</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-6 mb-4">
             <!-- Fact vs Dimensions -->
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Distribuição de Tabelas</h6>
                </div>
                <div class="card-body">
                    @if (Model.TotalTables > 0)
                    {
                        <h4 class="small font-weight-bold">Tabelas Facto <span class="float-right">@Model.FactTablesCount</span></h4>
                        <div class="progress mb-4">
                            @{
                                var factPercentage = (double)Model.FactTablesCount / Model.TotalTables * 100;
                            }
                            <div class="progress-bar bg-danger" role="progressbar" style="width: @factPercentage%"
                                aria-valuenow="@factPercentage" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>

                        <h4 class="small font-weight-bold">Dimensões / Outras <span class="float-right">@Model.DimensionTablesCount</span></h4>
                        <div class="progress mb-4">
                            @{
                                var dimPercentage = (double)Model.DimensionTablesCount / Model.TotalTables * 100;
                            }
                            <div class="progress-bar bg-warning" role="progressbar" style="width: @dimPercentage%"
                                aria-valuenow="@dimPercentage" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">Nenhuma tabela catalogada.</p>
                    }
                </div>
            </div>

             <!-- Largest Tables -->
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Maiores Tabelas (por linhas)</h6>
                </div>
                <div class="card-body">
                     @if (Model.LargestTables.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-bordered" width="100%" cellspacing="0">
                                <thead>
                                    <tr>
                                        <th>Tabela</th>
                                        <th>BD</th>
                                        <th>Linhas</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var table in Model.LargestTables)
                                    {
                                        <tr>
                                            <td>@table.TableName</td>
                                            <td>@table.DatabaseName</td>
                                            <td>@table.RowCount.ToString("N0")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">Sem dados de contagem de linhas.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .border-left-primary { border-left: .25rem solid #4e73df!important; }
    .border-left-success { border-left: .25rem solid #1cc88a!important; }
    .border-left-info { border-left: .25rem solid #36b9cc!important; }
    .border-left-warning { border-left: .25rem solid #f6c23e!important; }
    .text-gray-300 { color: #dddfeb!important; }
    .text-gray-800 { color: #5a5c69!important; }
</style>
