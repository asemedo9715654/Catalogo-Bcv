@model CatalogoBCV.Models.Role

@{
    ViewData["Title"] = "Remover Role";
}

@section ContentHeader {
    <div class="app-content-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-6">
                    <h3 class="mb-0">Remover Role</h3>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-end">
                        <li class="breadcrumb-item"><a asp-action="Index">Roles</a></li>
                        <li class="breadcrumb-item active">Remover</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>
}

<section class="content">
    <div class="container-fluid">
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-6">
                <div class="card card-danger">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="bi bi-exclamation-triangle me-2"></i> Confirmar Remoção
                        </h3>
                    </div>
                    <div class="card-body">
                        <p class="mb-3">
                            Tem a certeza que pretende remover o seguinte role?
                        </p>
                        <dl class="row">
                            <dt class="col-sm-3">Nome</dt>
                            <dd class="col-sm-9">@Model.Name</dd>

                            <dt class="col-sm-3">Descrição</dt>
                            <dd class="col-sm-9">@Model.Description</dd>
                        </dl>
                        <p class="text-muted small mb-0">
                            Nota: Roles associados a utilizadores não podem ser removidos.
                        </p>
                    </div>
                    <div class="card-footer bg-transparent">
                        <form asp-action="Delete">
                            <input type="hidden" asp-for="Id" />
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left me-1"></i> Cancelar
                            </a>
                            <button type="submit" class="btn btn-danger float-end">
                                <i class="bi bi-trash me-1"></i> Remover
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

