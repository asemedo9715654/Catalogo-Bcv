@{
    ViewData["Title"] = "Visualização Gráfica";
}

<h1>Visualização: @ViewBag.DatabaseName</h1>

<div>
    <a asp-controller="Catalog" asp-action="Details" asp-route-id="@ViewBag.DbId" class="btn btn-secondary mb-3">Voltar</a>
</div>

<div class="mermaid">@Html.Raw(ViewBag.MermaidData)</div>

@section Scripts {
    <script type="module">
        import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.esm.min.mjs';
        mermaid.initialize({ startOnLoad: true });
    </script>
}
