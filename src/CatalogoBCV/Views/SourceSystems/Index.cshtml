@model IEnumerable<CatalogoBCV.Models.SourceSystem>

@{
    ViewData["Title"] = "Sistemas de Origem";
}

@section ContentHeader {
    <div class="app-content-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-6">
                    <h3 class="mb-0">Sistemas de Origem</h3>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-end">
                        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                        <li class="breadcrumb-item active">Sistemas de Origem</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>
}

<section class="content">
    <div class="container-fluid">
        <!-- Resumo Estatístico -->
        <div class="row mb-3">
            <div class="col-12 col-sm-6 col-md-4">
                <div class="info-box">
                    <span class="info-box-icon bg-primary elevation-1"><i class="bi bi-server"></i></span>
                    <div class="info-box-content">
                        <span class="info-box-text">Sistemas Cadastrados</span>
                        <span class="info-box-number">
                            @Model.Count()
                        </span>
                    </div>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-md-4">
                <div class="info-box mb-3">
                    <span class="info-box-icon bg-success elevation-1"><i class="bi bi-check-circle"></i></span>
                    <div class="info-box-content">
                        <span class="info-box-text">Sistemas Ativos</span>
                        <span class="info-box-number">@Model.Count(s => s.IsActive)</span>
                    </div>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-md-4">
                <div class="info-box mb-3">
                    <span class="info-box-icon bg-danger elevation-1"><i class="bi bi-x-circle"></i></span>
                    <div class="info-box-content">
                        <span class="info-box-text">Sistemas Inativos</span>
                        <span class="info-box-number">@Model.Count(s => !s.IsActive)</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="card card-primary card-outline">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="bi bi-list-task me-2"></i>
                    Lista de Sistemas
                </h3>
                <div class="card-tools">
                    <a asp-action="Create" class="btn btn-primary btn-sm">
                        <i class="bi bi-plus-circle me-1"></i> Novo Sistema
                    </a>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Nome</th>
                                <th>Descrição</th>
                                <th class="text-center">Status</th>
                                <th>Criado em</th>
                                <th>Atualizado em</th>
                                <th class="text-end" style="width: 150px">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model) {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="bg-light rounded p-2 me-3 text-primary">
                                                <i class="bi bi-server fs-4"></i>
                                            </div>
                                            <div>
                                                <h6 class="mb-0 fw-bold">@item.Name</h6>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="text-muted">
                                            @if(!string.IsNullOrEmpty(item.Description))
                                            {
                                                @item.Description
                                            }
                                            else
                                            {
                                                <span class="fst-italic text-black-50">Sem descrição</span>
                                            }
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        @if(item.IsActive)
                                        {
                                            <span class="badge bg-success">Ativo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Inativo</span>
                                        }
                                    </td>
                                    <td>@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@(item.UpdatedAt.HasValue ? item.UpdatedAt.Value.ToString("dd/MM/yyyy HH:mm") : "-")</td>
                                    <td class="text-end">
                                        <div class="btn-group">
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Editar">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Excluir">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>
