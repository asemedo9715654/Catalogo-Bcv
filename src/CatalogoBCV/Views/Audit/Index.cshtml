@model IEnumerable<CatalogoBCV.Models.AuditLog>

@{
    ViewData["Title"] = "Auditoria";
}

<!-- DataTables CSS -->
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" />

@section ContentHeader {
    <div class="app-content-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-6">
                    <h3 class="mb-0">Logs de Auditoria</h3>
                </div>
            </div>
        </div>
    </div>
}

<section class="content">
    <div class="container-fluid">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Histórico de Alterações</h3>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table id="auditTable" class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Data</th>
                                <th>Utilizador</th>
                                <th>Ação</th>
                                <th>Entidade</th>
                                <th>ID Entidade</th>
                                <th>Valor Antigo</th>
                                <th>Novo Valor</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.Timestamp</td>
                                    <td>@item.Username</td>
                                    <td>
                                        <span class="badge bg-@(item.Action == "Create" ? "success" : item.Action == "Update" ? "warning" : "danger")">
                                            @item.Action
                                        </span>
                                    </td>
                                    <td>@item.EntityType</td>
                                    <td>@item.EntityId</td>
                                    <td class="text-truncate" style="max-width: 150px;" title="@item.OldValue">@item.OldValue</td>
                                    <td class="text-truncate" style="max-width: 150px;" title="@item.NewValue">@item.NewValue</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <!-- DataTables & Plugins -->
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
    
    <script>
        $(document).ready(function () {
            $('#auditTable').DataTable({
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.13.7/i18n/pt-PT.json"
                },
                "order": [[0, "desc"]], // Ordenar por data decrescente
                "responsive": true,
                "autoWidth": false
            });
        });
    </script>
}
