@model IEnumerable<CatalogoBCV.Models.AuditLog>

@{
    ViewData["Title"] = "Auditoria";
}

<h1>Logs de Auditoria</h1>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Data</th>
                <th>Utilizador</th>
                <th>Ação</th>
                <th>Entidade</th>
                <th>ID Entidade</th>
                <th>Valor Antigo</th>
                <th>Novo Valor</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Timestamp</td>
                    <td>@item.Username</td>
                    <td>@item.Action</td>
                    <td>@item.EntityType</td>
                    <td>@item.EntityId</td>
                    <td class="text-truncate" style="max-width: 150px;" title="@item.OldValue">@item.OldValue</td>
                    <td class="text-truncate" style="max-width: 150px;" title="@item.NewValue">@item.NewValue</td>
                </tr>
            }
        </tbody>
    </table>
</div>
